# Environment Variables
# Copy this file to .env and fill in required values.
# Never commit the .env file.

# ── SERVER ─────────────────────────────────────────────────────────────────────
# Render assigns PORT automatically; do NOT hardcode it in production.
PORT=5005
HOST=127.0.0.1
NODE_ENV=development

# ── CORS ───────────────────────────────────────────────────────────────────────
# In production (same-origin deployment), this is not required.
# Set only if running frontend and backend on separate origins (local dev only).
# FRONTEND_URL=http://localhost:5173

# ── EXTERNAL APIS ──────────────────────────────────────────────────────────────
# AviationStack API (optional — app works without it using mock data)
AVIATIONSTACK_API_KEY=
AVIATIONSTACK_BASE_URL=https://api.aviationstack.com

# ── DATABASE (OPTIONAL — not required for current deployment) ──────────────────
# If you add Render Postgres, set this variable.
# The app uses in-memory persistence by default (see README §6 for upgrade steps).
# DATABASE_URL=postgresql://user:password@host:5432/skylark
